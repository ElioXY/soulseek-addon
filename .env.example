# Copy to .env — read by src/config.js and docker/entrypoint.sh.

PORT=3000

# --- SoulSeek account (required for real results) -------------------------
# The image starts slskd with these and generates slskd.yml from them.
# Without all three, the addon runs alone in mock mode.
SLSKD_USERNAME=
SLSKD_PASSWORD=
# Shared secret for slskd's API. Any random string of 16-255 characters;
# slskd rejects anything shorter. Generate one with: openssl rand -hex 24
SLSKD_API_KEY=
# SoulSeek peer port (must be reachable from the internet to avoid firewalled status).
SLSKD_LISTEN_PORT=50300

# --- Addon ----------------------------------------------------------------
# Public HTTPS URL of this addon. Leave empty on a PaaS: the origin is read from
# each request (x-forwarded-host/proto), so a fresh deploy works unconfigured.
# Set it only to force a canonical origin.
PUBLIC_BASE_URL=

# Set automatically in the combined image; only needed when the addon runs alone
# against an external slskd.
# SLSKD_URL=http://127.0.0.1:5030

# How long to collect distributed search responses / wait for a download's first
# bytes when the player opens /media (keep below 8000: ExoPlayer's HTTP timeout).
SEARCH_TIMEOUT_MS=8000
MEDIA_WAIT_MS=6000
# How long a one-off search may take to resolve a file exact size. slskd reads a
# request without a size as 0 and the transfer aborts, so an unresolved size is a skip.
SIZE_LOOKUP_MS=6500

# --- Storage ----------------------------------------------------------------
# A track is deleted this long after the last byte was sent to a player. Every
# request (a seek, a second listener) restarts the clock, so nobody loses audio
# mid-listen. -1 keeps everything.
DELETE_AFTER_MS=300000
# Hard cap for downloads + incomplete (MiB). Oldest files are evicted first.
# Leave headroom on a small volume: a full disk breaks every later transfer.
# 0 disables the cap.
MAX_STORAGE_MB=700
# How often the cap is checked. 0 disables the background check.
CLEANUP_INTERVAL_MS=60000

ADDON_ID=dev.soulseek.addon
ADDON_NAME=SoulSeek (via slskd)
ADDON_VERSION=0.1.0
