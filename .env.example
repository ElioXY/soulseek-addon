# Copy to .env — values are read by src/config.js
PORT=3000
# Public HTTPS URL of THIS addon (BitChord needs absolute stream URLs).
# For local testing: http://localhost:3000  |  For real use: https://your-host
PUBLIC_BASE_URL=http://localhost:3000

# --- Real SoulSeek mode (leave empty for mock/dev mode) ---
# slskd = headless SoulSeek daemon. No desktop app needed, but SOMETHING must
# stay logged into the SoulSeek network — there is no public/anonymous API.
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=
# Shared folder slskd downloads into (same volume in docker-compose.yml)
DOWNLOAD_DIR=./downloads
# Partial downloads live here until complete (served progressively)
INCOMPLETE_DIR=./incomplete
# Timing
SEARCH_TIMEOUT_MS=8000
STREAM_WAIT_MS=20000

# --- Addon identity ---
ADDON_ID=dev.soulseek.addon
ADDON_NAME=SoulSeek (via slskd)
ADDON_VERSION=0.1.0
